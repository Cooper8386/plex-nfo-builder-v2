API_TOKEN=
# Compose host paths; create both directories first. Use D:/path on Windows.
MEDIA_PATH=
CONFIG_PATH=./config
HOST_PORT=8765
# edge follows main; use a published version tag for a fixed release.
IMAGE_TAG=edge
# The paths below are inside the container; Compose keeps these mount targets.
MEDIA_ROOT=/media
CONFIG_DIR=/config
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000
LOG_LEVEL=INFO
TZ=America/Chicago
CORS_ALLOW_ORIGINS=
TRUSTED_HOSTS=
TVDB_API_KEY=
TVDB_PIN=
TMDB_API_KEY=
FANART_API_KEY=
PLEX_TOKEN=
WATCHER_ENABLED=true
WATCHER_DEBOUNCE_SECONDS=30
WATCHER_MAX_INFLIGHT=2
WATCHER_KILL_SWITCH=false
